@page
@model ExpenseApp.Pages.ApproveExpensesModel
@{
    ViewData["Title"] = "Approve Expenses";
    ViewData["ActivePage"] = "ApproveExpenses";
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show error-banner" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>Database Connection Issue:</strong>
        <span>@Model.ErrorMessage</span>
        <br /><small class="mt-1 d-block"><strong>Note:</strong> Showing sample data below.</small>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-title">Approve Expenses</h1>
        <p class="page-subtitle">Review and action pending expense submissions</p>
    </div>
    <span class="badge bg-warning text-dark fs-6">
        <i class="bi bi-hourglass-split me-1"></i>
        @Model.Expenses.Count pending
    </span>
</div>

<!-- Filter -->
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="d-flex gap-2 align-items-center">
            <i class="bi bi-search text-muted"></i>
            <input type="text" id="approveSearch" class="form-control form-control-sm" placeholder="Filter by employee, category or description..." oninput="filterApproveTable()" style="max-width:400px" />
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-inbox me-2"></i>Pending Review</h5>
    </div>
    <div class="card-body p-0">
        @if (!Model.Expenses.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-check-circle text-success" style="font-size:3rem"></i>
                <p class="mt-2 text-muted">No expenses pending approval</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="approveTable">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Employee</th>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>Description</th>
                            <th>Submitted</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="approveTableBody">
                        @foreach (var expense in Model.Expenses)
                        {
                            <tr data-search="@(expense.UserName.ToLower()) @(expense.CategoryName.ToLower()) @(expense.Description?.ToLower())">
                                <td>@expense.ExpenseDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-sm">@(expense.UserName.FirstOrDefault())</div>
                                        <span>@expense.UserName</span>
                                    </div>
                                </td>
                                <td><span class="badge bg-secondary">@expense.CategoryName</span></td>
                                <td class="fw-bold">£@expense.AmountGBP.ToString("N2")</td>
                                <td>@(expense.Description ?? "-")</td>
                                <td class="text-muted small">@(expense.SubmittedAt?.ToString("dd MMM HH:mm") ?? "-")</td>
                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center">
                                        <button class="btn btn-sm btn-success" onclick="approveExpense(@expense.ExpenseId)" title="Approve">
                                            <i class="bi bi-check-lg me-1"></i>Approve
                                        </button>
                                        <button class="btn btn-sm btn-danger" onclick="rejectExpense(@expense.ExpenseId)" title="Reject">
                                            <i class="bi bi-x-lg me-1"></i>Reject
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    function filterApproveTable() {
        const search = document.getElementById('approveSearch').value.toLowerCase();
        const rows = document.querySelectorAll('#approveTableBody tr');
        rows.forEach(row => {
            const text = row.dataset.search || '';
            row.style.display = !search || text.includes(search) ? '' : 'none';
        });
    }

    async function approveExpense(id) {
        if (!confirm('Approve this expense?')) return;
        try {
            const res = await fetch(`/api/expenses/${id}/approve`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reviewedBy: 2 })
            });
            if (res.ok) { location.reload(); }
            else { alert('Failed to approve expense.'); }
        } catch { alert('Network error.'); }
    }

    async function rejectExpense(id) {
        if (!confirm('Reject this expense?')) return;
        try {
            const res = await fetch(`/api/expenses/${id}/reject`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reviewedBy: 2 })
            });
            if (res.ok) { location.reload(); }
            else { alert('Failed to reject expense.'); }
        } catch { alert('Network error.'); }
    }
</script>
}
