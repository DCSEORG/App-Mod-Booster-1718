@page
@model ExpenseApp.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="page-header">
    <h1 class="page-title text-danger">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>An Error Occurred
    </h1>
</div>

<div class="card">
    <div class="card-body">
        <p class="text-muted">Sorry, something went wrong. Please try again or contact support.</p>
        @if (Model.RequestId != null)
        {
            <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
        }
        <a asp-page="/Index" class="btn btn-primary">
            <i class="bi bi-house me-1"></i> Back to Dashboard
        </a>
    </div>
</div>
