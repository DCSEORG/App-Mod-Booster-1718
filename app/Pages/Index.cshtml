@page
@model ExpenseApp.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Index";
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show error-banner" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>Database Connection Issue:</strong>
        <span>@Model.ErrorMessage</span>
        <br /><small class="mt-1 d-block"><strong>Note:</strong> Showing sample data below. The app is functional but connected to dummy data.</small>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Page Header -->
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-title">Expense Dashboard</h1>
        <p class="page-subtitle">Manage and track your expenses</p>
    </div>
    <button class="btn btn-primary btn-add" data-bs-toggle="modal" data-bs-target="#addExpenseModal">
        <i class="bi bi-plus-lg me-1"></i> Add Expense
    </button>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card stat-total">
            <div class="stat-icon"><i class="bi bi-receipt"></i></div>
            <div class="stat-value">@Model.Expenses.Count</div>
            <div class="stat-label">Total Expenses</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card stat-draft">
            <div class="stat-icon"><i class="bi bi-pencil-square"></i></div>
            <div class="stat-value">@Model.Expenses.Count(e => e.StatusName == "Draft")</div>
            <div class="stat-label">Drafts</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card stat-submitted">
            <div class="stat-icon"><i class="bi bi-send"></i></div>
            <div class="stat-value">@Model.Expenses.Count(e => e.StatusName == "Submitted")</div>
            <div class="stat-label">Pending Review</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card stat-approved">
            <div class="stat-icon"><i class="bi bi-check-circle"></i></div>
            <div class="stat-value">£@Model.Expenses.Where(e => e.StatusName == "Approved").Sum(e => e.AmountGBP).ToString("N2")</div>
            <div class="stat-label">Approved Total</div>
        </div>
    </div>
</div>

<!-- Expenses Table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-table me-2"></i>My Expenses</h5>
        <div class="d-flex gap-2">
            <select id="statusFilter" class="form-select form-select-sm" style="width:auto" onchange="filterExpenses()">
                <option value="">All Statuses</option>
                <option value="Draft">Draft</option>
                <option value="Submitted">Submitted</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
            </select>
            <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Search..." style="width:180px" oninput="filterExpenses()" />
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" id="expensesTable">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Category</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="expenseTableBody">
                    @foreach (var expense in Model.Expenses)
                    {
                        <tr data-status="@expense.StatusName" data-search="@(expense.Description?.ToLower()) @(expense.CategoryName.ToLower())">
                            <td>@expense.ExpenseDate.ToString("dd MMM yyyy")</td>
                            <td>@(expense.Description ?? "-")</td>
                            <td><span class="badge bg-secondary">@expense.CategoryName</span></td>
                            <td class="fw-bold">£@expense.AmountGBP.ToString("N2")</td>
                            <td>
                                @{
                                    var badgeClass = expense.StatusName switch
                                    {
                                        "Draft" => "badge-draft",
                                        "Submitted" => "badge-submitted",
                                        "Approved" => "badge-approved",
                                        "Rejected" => "badge-rejected",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass">@expense.StatusName</span>
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    @if (expense.StatusName == "Draft")
                                    {
                                        <button class="btn btn-sm btn-outline-primary" onclick="submitExpense(@expense.ExpenseId)" title="Submit for approval">
                                            <i class="bi bi-send"></i>
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteExpense(@expense.ExpenseId)" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Expense Modal -->
<div class="modal fade" id="addExpenseModal" tabindex="-1" aria-labelledby="addExpenseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addExpenseModalLabel">
                    <i class="bi bi-plus-circle me-2"></i>Add New Expense
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="modalError" class="alert alert-danger d-none"></div>
                <form id="addExpenseForm">
                    <div class="mb-3">
                        <label for="expAmount" class="form-label">Amount (£) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">£</span>
                            <input type="number" class="form-control" id="expAmount" step="0.01" min="0.01" max="100000" placeholder="0.00" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="expDate" class="form-label">Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="expDate" required />
                    </div>
                    <div class="mb-3">
                        <label for="expCategory" class="form-label">Category <span class="text-danger">*</span></label>
                        <select class="form-select" id="expCategory" required>
                            <option value="">-- Select Category --</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.CategoryId">@cat.CategoryName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="expDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="expDescription" rows="3" maxlength="1000" placeholder="What was this expense for?"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveExpenseBtn" onclick="saveExpense()">
                    <i class="bi bi-save me-1"></i> Save Expense
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Set today's date as default
    document.getElementById('expDate').valueAsDate = new Date();

    function filterExpenses() {
        const statusFilter = document.getElementById('statusFilter').value.toLowerCase();
        const searchText = document.getElementById('searchInput').value.toLowerCase();
        const rows = document.querySelectorAll('#expenseTableBody tr');
        rows.forEach(row => {
            const rowStatus = row.dataset.status.toLowerCase();
            const rowSearch = row.dataset.search || '';
            const matchStatus = !statusFilter || rowStatus === statusFilter;
            const matchSearch = !searchText || rowSearch.includes(searchText);
            row.style.display = matchStatus && matchSearch ? '' : 'none';
        });
    }

    async function saveExpense() {
        const btn = document.getElementById('saveExpenseBtn');
        const modalError = document.getElementById('modalError');
        modalError.classList.add('d-none');

        const amount = parseFloat(document.getElementById('expAmount').value);
        const date = document.getElementById('expDate').value;
        const categoryId = parseInt(document.getElementById('expCategory').value);
        const description = document.getElementById('expDescription').value;

        if (!amount || !date || !categoryId) {
            modalError.textContent = 'Please fill in all required fields.';
            modalError.classList.remove('d-none');
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';

        try {
            const response = await fetch('/api/expenses', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    userId: 1,
                    categoryId: categoryId,
                    amountGBP: amount,
                    expenseDate: date,
                    description: description
                })
            });

            if (response.ok) {
                bootstrap.Modal.getInstance(document.getElementById('addExpenseModal')).hide();
                location.reload();
            } else {
                const data = await response.json();
                modalError.textContent = data.message || 'Failed to save expense.';
                modalError.classList.remove('d-none');
            }
        } catch (err) {
            modalError.textContent = 'Network error. Please try again.';
            modalError.classList.remove('d-none');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-save me-1"></i> Save Expense';
        }
    }

    async function submitExpense(id) {
        if (!confirm('Submit this expense for approval?')) return;
        try {
            const res = await fetch(`/api/expenses/${id}/submit`, { method: 'PUT' });
            if (res.ok) { location.reload(); }
            else { alert('Failed to submit expense.'); }
        } catch { alert('Network error.'); }
    }

    async function deleteExpense(id) {
        if (!confirm('Are you sure you want to delete this expense?')) return;
        try {
            const res = await fetch(`/api/expenses/${id}`, { method: 'DELETE' });
            if (res.ok) { location.reload(); }
            else { alert('Failed to delete expense.'); }
        } catch { alert('Network error.'); }
    }
</script>
}
